import { useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { api } from "../lib/api-client";
import { useAuth } from "../features/auth/AuthContext";

export function AppointmentsPage() {
  const { user } = useAuth();
  const qc = useQueryClient();
  const isPatient = user!.roles.includes("PATIENT");
  const appts = useQuery({ queryKey: ["appointments"], queryFn: () => api<any[]>("/appointments") });
  const doctors = useQuery({ queryKey: ["doctors"], queryFn: () => api<any[]>("/appointments/doctors"), enabled: isPatient });
  const [doctorId, setDoctorId] = useState(""); const [startAt, setStartAt] = useState(""); const [reason, setReason] = useState("");
  const book = useMutation({
    mutationFn: () => api("/appointments", { method: "POST", body: JSON.stringify({ doctorId, startAt: new Date(startAt).toISOString(), reason }) }),
    onSuccess: () => { qc.invalidateQueries({ queryKey: ["appointments"] }); setReason(""); },
  });
  const setStatus = useMutation({
    mutationFn: (v: { id: string; status: string }) => api(`/appointments/${v.id}/status`, { method: "PATCH", body: JSON.stringify({ status: v.status }) }),
    onSuccess: () => qc.invalidateQueries({ queryKey: ["appointments"] }),
  });
  const isDoctor = user!.roles.includes("DOCTOR"); const isDesk = user!.roles.some((r) => ["RECEPTIONIST", "ADMIN"].includes(r));
  const field = "rounded-lg border border-slate-300 px-3 py-2 text-sm";
  return (
    <div className="space-y-6">
      <h1 className="text-2xl font-semibold">Appointments</h1>
      {isPatient && (
        <div className="flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-sm">
          <select className={field} value={doctorId} onChange={(e) => setDoctorId(e.target.value)}>
            <option value="">Select doctor</option>
            {doctors.data?.map((d) => <option key={d.id} value={d.id}>{d.user.name} — {d.speciality}</option>)}
          </select>
          <input type="datetime-local" className={field} value={startAt} onChange={(e) => setStartAt(e.target.value)} />
          <input placeholder="Reason" className={field} value={reason} onChange={(e) => setReason(e.target.value)} />
          <button disabled={!doctorId || !startAt || book.isPending} onClick={() => book.mutate()} className="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">Book</button>
          {book.error && <span className="text-sm text-red-600">{(book.error as Error).message}</span>}
        </div>
      )}
      <div className="overflow-x-auto rounded-xl bg-white shadow-sm">
        <table className="w-full text-left text-sm">
          <thead className="bg-slate-100 text-slate-600"><tr>{["When", "Patient", "Doctor", "Status", ""].map((h) => <th key={h} className="px-4 py-2">{h}</th>)}</tr></thead>
          <tbody>
            {appts.data?.map((a) => (
              <tr key={a.id} className="border-t">
                <td className="px-4 py-2">{new Date(a.startAt).toLocaleString()}</td>
                <td className="px-4 py-2">{a.patient.user.name}</td><td className="px-4 py-2">{a.doctor.user.name}</td>
                <td className="px-4 py-2">{a.status}</td>
                <td className="space-x-2 px-4 py-2">
                  {a.status === "SCHEDULED" && isDesk && <button className="text-blue-600" onClick={() => setStatus.mutate({ id: a.id, status: "CHECKED_IN" })}>Check in</button>}
                  {isDoctor && ["CHECKED_IN", "SCHEDULED"].includes(a.status) && <button className="text-blue-600" onClick={() => setStatus.mutate({ id: a.id, status: "IN_PROGRESS" })}>Start</button>}
                  {isDoctor && a.status === "IN_PROGRESS" && <button className="text-green-600" onClick={() => setStatus.mutate({ id: a.id, status: "COMPLETED" })}>Complete</button>}
                  {(isPatient || isDesk) && ["SCHEDULED", "CHECKED_IN"].includes(a.status) && <button className="text-red-600" onClick={() => setStatus.mutate({ id: a.id, status: "CANCELLED" })}>Cancel</button>}
                </td>
              </tr>
            ))}
            {appts.data?.length === 0 && <tr><td colSpan={5} className="px-4 py-6 text-center text-slate-500">No appointments</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}
