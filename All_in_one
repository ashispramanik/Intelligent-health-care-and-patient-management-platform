  if (user) return <Navigate to={homeFor(user)} replace />;
  const onSubmit = async (v: F) => {
    setError("");
    try { nav(homeFor(await login(v.email, v.password)), { replace: true }); }
    catch (e) { setError((e as Error).message); }
  };
  const input = "w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100";
  return (
