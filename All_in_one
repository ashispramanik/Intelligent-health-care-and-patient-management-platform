## `backend/src/routes/appointments.ts`

````ts
import { Router } from "express";
import { z } from "zod";
import { audit, prisma } from "../lib/prisma";
import { authorize } from "../middleware/authorize";

export const appointmentsRouter = Router();
const STAFF = ["ADMIN", "RECEPTIONIST", "NURSE"];
const include = { doctor: { include: { user: { select: { name: true } } } }, patient: { include: { user: { select: { name: true } } } } };

appointmentsRouter.get("/doctors", async (_req, res) => {
  res.json(await prisma.doctor.findMany({ where: { verificationStatus: "VERIFIED" }, include: { user: { select: { name: true } }, department: true, schedules: true } }));
});

appointmentsRouter.get("/", async (req, res) => {
  const roles = req.user!.roles;
  let where = {};
  if (roles.includes("PATIENT")) where = { patient: { userId: req.user!.id } };
  else if (roles.includes("DOCTOR")) where = { doctor: { userId: req.user!.id } };
  else if (!roles.some((r) => STAFF.includes(r))) return res.status(403).json({ error: "Forbidden" });
  res.json(await prisma.appointment.findMany({ where, include, orderBy: { startAt: "asc" }, take: 200 }));
});

const bookSchema = z.object({ doctorId: z.string().uuid(), startAt: z.coerce.date(), reason: z.string().max(500).optional(), patientId: z.string().uuid().optional() });

appointmentsRouter.post("/", authorize("PATIENT", "RECEPTIONIST", "ADMIN"), async (req, res) => {
  const b = bookSchema.parse(req.body);
  if (b.startAt < new Date()) return res.status(400).json({ error: "Cannot book in the past" });
  const endAt = new Date(b.startAt.getTime() + 30 * 60_000);
  let patientId = b.patientId;
  if (req.user!.roles.includes("PATIENT")) {
    const me = await prisma.patient.findUnique({ where: { userId: req.user!.id } });
    if (!me) return res.status(400).json({ error: "No patient profile" });
    patientId = me.id;
  }
  if (!patientId) return res.status(400).json({ error: "patientId required" });
  const clash = await prisma.appointment.findFirst({
    where: { doctorId: b.doctorId, status: { notIn: ["CANCELLED", "NO_SHOW"] }, startAt: { lt: endAt }, endAt: { gt: b.startAt } },
  });
  if (clash) return res.status(409).json({ error: "Slot already booked" });
  const appt = await prisma.appointment.create({ data: { patientId, doctorId: b.doctorId, startAt: b.startAt, endAt, reason: b.reason }, include });
  await audit(req.user!.id, "APPOINTMENT_CREATE", "Appointment", appt.id);
  res.status(201).json(appt);
});

appointmentsRouter.patch("/:id/status", async (req, res) => {
  const { status } = z.object({ status: z.enum(["CHECKED_IN", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NO_SHOW"]) }).parse(req.body);
  const appt = await prisma.appointment.findUnique({ where: { id: req.params.id }, include: { patient: true, doctor: true } });
  if (!appt) return res.status(404).json({ error: "Not found" });
  const roles = req.user!.roles;
  const isOwnerPatient = roles.includes("PATIENT") && appt.patient.userId === req.user!.id;
  const isOwnerDoctor = roles.includes("DOCTOR") && appt.doctor.userId === req.user!.id;
  const allowed = roles.some((r) => ["ADMIN", "RECEPTIONIST"].includes(r)) || (isOwnerPatient && status === "CANCELLED") || (isOwnerDoctor && ["IN_PROGRESS", "COMPLETED", "NO_SHOW"].includes(status));
  if (!allowed) return res.status(403).json({ error: "Forbidden" });
  const updated = await prisma.appointment.update({ where: { id: appt.id }, data: { status }, include });
  await audit(req.user!.id, `APPOINTMENT_${status}`, "Appointment", appt.id);
  res.json(updated);
});
````

## `backend/src/routes/auth.ts`

````ts
import { Router } from "express";
import bcrypt from "bcryptjs";
import jwt from "jsonwebtoken";
import rateLimit from "express-rate-limit";
import { z } from "zod";
import { env } from "../config/env";
import { audit, prisma } from "../lib/prisma";
import { authenticate } from "../middleware/authenticate";

export const authRouter = Router();
const loginLimiter = rateLimit({ windowMs: 15 * 60_000, limit: 20 });
const cookieOpts = { httpOnly: true, sameSite: "lax" as const, secure: env.NODE_ENV === "production", path: "/api/auth" };

const publicUser = (u: { id: string; name: string; email: string; roles: { role: { name: string } }[] }) =>
  ({ id: u.id, name: u.name, email: u.email, roles: u.roles.map((r) => r.role.name) });

const sign = (id: string, roles: string[]) => ({
  access: jwt.sign({ sub: id, roles }, env.JWT_ACCESS_SECRET, { expiresIn: "15m" }),
  refresh: jwt.sign({ sub: id }, env.JWT_REFRESH_SECRET, { expiresIn: "7d" }),
});

authRouter.post("/login", loginLimiter, async (req, res) => {
  const { email, password } = z.object({ email: z.string().email(), password: z.string().min(1) }).parse(req.body);
  const user = await prisma.user.findUnique({ where: { email: email.toLowerCase() }, include: { roles: { include: { role: true } } } });
  const fail = () => res.status(401).json({ error: "Invalid email or password" });
  if (!user || user.status !== "ACTIVE") return fail();
  if (user.lockedUntil && user.lockedUntil > new Date()) return res.status(423).json({ error: "Account temporarily locked. Try later." });
  if (!(await bcrypt.compare(password, user.passwordHash))) {
    const failed = user.failedLogins + 1;
    await prisma.user.update({ where: { id: user.id }, data: { failedLogins: failed, lockedUntil: failed >= 5 ? new Date(Date.now() + 15 * 60_000) : null } });
    await audit(user.id, "LOGIN_FAILED", "User", user.id);
    return fail();
  }
  await prisma.user.update({ where: { id: user.id }, data: { failedLogins: 0, lockedUntil: null } });
  const u = publicUser(user);
  const t = sign(u.id, u.roles);
  res.cookie("rt", t.refresh, { ...cookieOpts, maxAge: 7 * 864e5 });
  await audit(u.id, "LOGIN", "User", u.id);
  res.json({ accessToken: t.access, user: u });
});

authRouter.post("/refresh", async (req, res) => {
  try {
    const p = jwt.verify(req.cookies.rt, env.JWT_REFRESH_SECRET) as { sub: string };
    const user = await prisma.user.findUnique({ where: { id: p.sub }, include: { roles: { include: { role: true } } } });
    if (!user || user.status !== "ACTIVE") throw new Error();
    const u = publicUser(user);
    res.json({ accessToken: sign(u.id, u.roles).access, user: u });
  } catch { res.status(401).json({ error: "Session expired" }); }
});

authRouter.post("/logout", (_req, res) => { res.clearCookie("rt", cookieOpts); res.json({ ok: true }); });

authRouter.get("/me", authenticate, async (req, res) => {
  const user = await prisma.user.findUniqueOrThrow({ where: { id: req.user!.id }, include: { roles: { include: { role: true } } } });
  res.json(publicUser(user));
});
````

## `backend/src/routes/users.ts`

````ts
import { Router } from "express";
import bcrypt from "bcryptjs";
import { z } from "zod";
import { audit, prisma } from "../lib/prisma";
import { authorize } from "../middleware/authorize";

export const usersRouter = Router();
usersRouter.use(authorize("ADMIN"));

usersRouter.get("/", async (_req, res) => {
  const users = await prisma.user.findMany({ select: { id: true, name: true, email: true, status: true, createdAt: true, roles: { select: { role: { select: { name: true } } } } }, orderBy: { createdAt: "desc" } });
  res.json(users.map((u) => ({ ...u, roles: u.roles.map((r) => r.role.name) })));
});

usersRouter.post("/", async (req, res) => {
  const b = z.object({
    name: z.string().min(2), email: z.string().email(),
    password: z.string().min(10, "Use at least 10 characters"),
    role: z.enum(["ADMIN", "DOCTOR", "NURSE", "RECEPTIONIST", "LAB", "PHARMACIST", "PATIENT"]),
  }).parse(req.body);
  if (await prisma.user.findUnique({ where: { email: b.email.toLowerCase() } })) return res.status(409).json({ error: "Email already exists" });
  const role = await prisma.role.findUniqueOrThrow({ where: { name: b.role } });
  const user = await prisma.user.create({
    data: { name: b.name, email: b.email.toLowerCase(), passwordHash: await bcrypt.hash(b.password, 12), mustChangePassword: true, roles: { create: { roleId: role.id } } },
  });
  if (b.role === "PATIENT") await prisma.patient.create({ data: { userId: user.id } });
  await audit(req.user!.id, "USER_CREATE", "User", user.id);
  res.status(201).json({ id: user.id, email: user.email });
});

usersRouter.patch("/:id/status", async (req, res) => {
  const { status } = z.object({ status: z.enum(["ACTIVE", "SUSPENDED"]) }).parse(req.body);
  if (req.params.id === req.user!.id) return res.status(400).json({ error: "Cannot change your own status" });
  await prisma.user.update({ where: { id: req.params.id }, data: { status } });
  await audit(req.user!.id, `USER_${status}`, "User", req.params.id);
  res.json({ ok: true });
});
````

