import { createContext, useContext, useEffect, useState, ReactNode } from "react";
import { api, refreshSession, setAccessToken } from "../../lib/api-client";

export type User = { id: string; name: string; email: string; roles: string[] };
type Ctx = { user: User | null; loading: boolean; login: (e: string, p: string) => Promise<User>; logout: () => Promise<void> };
const AuthCtx = createContext<Ctx>(null!);
export const useAuth = () => useContext(AuthCtx);

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(true);
  useEffect(() => { refreshSession().then(setUser).finally(() => setLoading(false)); }, []);
  const login = async (email: string, password: string) => {
    const d = await api("/auth/login", { method: "POST", body: JSON.stringify({ email, password }) });
    setAccessToken(d.accessToken); setUser(d.user); return d.user as User;
  };
  const logout = async () => { await api("/auth/logout", { method: "POST" }); setAccessToken(null); setUser(null); };
  return <AuthCtx.Provider value={{ user, loading, login, logout }}>{children}</AuthCtx.Provider>;
}

export const HOME: Record<string, string> = {
  ADMIN: "/admin/dashboard", DOCTOR: "/doctor/dashboard", NURSE: "/nurse/dashboard",
  RECEPTIONIST: "/reception/queue", LAB: "/lab/orders", PHARMACIST: "/pharmacy/inventory", PATIENT: "/patient/dashboard",
};
export const homeFor = (u: User) => HOME[u.roles[0]] ?? "/login";
