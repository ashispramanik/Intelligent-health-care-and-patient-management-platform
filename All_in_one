## `backend/prisma/schema.prisma`

````prisma
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }

enum RoleName { ADMIN DOCTOR NURSE RECEPTIONIST LAB PHARMACIST PATIENT }
enum UserStatus { ACTIVE SUSPENDED }
enum VerificationStatus { PENDING VERIFIED REJECTED }
enum AppointmentStatus { SCHEDULED CHECKED_IN IN_PROGRESS COMPLETED CANCELLED NO_SHOW }

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  mustChangePassword Boolean @default(false)
  createdAt    DateTime   @default(now())
  roles        UserRole[]
  patient      Patient?
  doctor       Doctor?
  auditLogs    AuditLog[]
}
model Role { id Int @id @default(autoincrement())
  name  RoleName @unique
  users UserRole[] }
model UserRole {
  userId String
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}
model Department { id String @id @default(uuid())
  name String @unique
  description String?
  doctors Doctor[] }
model Patient {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  dateOfBirth DateTime?
  phone String?
  emergencyContact String?
  appointments Appointment[]
}
model Doctor {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  speciality String
  qualifications String?
  verificationStatus VerificationStatus @default(PENDING)
  schedules DoctorSchedule[]
  appointments Appointment[]
}
model DoctorSchedule {
  id String @id @default(uuid())
  doctorId String
  doctor Doctor @relation(fields: [doctorId], references: [id])
  weekday Int
  startTime String
  endTime String
}
model Appointment {
  id String @id @default(uuid())
  patientId String
  doctorId String
  patient Patient @relation(fields: [patientId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  startAt DateTime
  endAt DateTime
  status AppointmentStatus @default(SCHEDULED)
  reason String?
  createdAt DateTime @default(now())
  @@index([doctorId, startAt])
  @@index([patientId, startAt])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id])
  action String
  resourceType String
  resourceId String?
  timestamp DateTime @default(now())
  @@index([actorId, timestamp])
}
````

## `backend/prisma/seed.ts`

````ts
import { PrismaClient, RoleName } from "@prisma/client";
import bcrypt from "bcryptjs";
const prisma = new PrismaClient();

// DEVELOPMENT-ONLY credentials. Never seed these in production.
const users: { name: string; email: string; password: string; role: RoleName }[] = [
  { name: "Hospital Admin", email: "admin@medicore.local", password: "Admin@12345", role: "ADMIN" },
  { name: "Dr. Rohan Mehta", email: "doctor@medicore.local", password: "Doctor@12345", role: "DOCTOR" },
  { name: "Nurse Anita Das", email: "nurse@medicore.local", password: "Nurse@12345", role: "NURSE" },
  { name: "Front Desk Riya", email: "frontdesk@medicore.local", password: "Desk@12345", role: "RECEPTIONIST" },
  { name: "Lab Tech Sameer", email: "lab@medicore.local", password: "Lab@12345", role: "LAB" },
  { name: "Pharmacist Neha", email: "pharmacy@medicore.local", password: "Pharma@12345", role: "PHARMACIST" },
  { name: "Arjun Sharma", email: "patient@medicore.local", password: "Patient@12345", role: "PATIENT" },
];

async function main() {
  if (process.env.NODE_ENV === "production") throw new Error("Refusing to seed demo users in production");
  for (const name of Object.values(RoleName)) {
    await prisma.role.upsert({ where: { name }, update: {}, create: { name } });
  }
  const dept = await prisma.department.upsert({
    where: { name: "Cardiology" }, update: {}, create: { name: "Cardiology", description: "Heart care" },
  });
  for (const u of users) {
    const role = await prisma.role.findUniqueOrThrow({ where: { name: u.role } });
    const user = await prisma.user.upsert({
      where: { email: u.email },
      update: {},
      create: {
        name: u.name, email: u.email, passwordHash: await bcrypt.hash(u.password, 12),
        roles: { create: { roleId: role.id } },
      },
    });
    if (u.role === "DOCTOR") {
      const doc = await prisma.doctor.upsert({
        where: { userId: user.id }, update: {},
        create: { userId: user.id, departmentId: dept.id, speciality: "Cardiologist", verificationStatus: "VERIFIED" },
      });
      if (!(await prisma.doctorSchedule.findFirst({ where: { doctorId: doc.id } }))) {
        await prisma.doctorSchedule.createMany({
          data: [1, 2, 3, 4, 5].map((weekday) => ({ doctorId: doc.id, weekday, startTime: "09:00", endTime: "17:00" })),
        });
      }
    }
    if (u.role === "PATIENT") {
      await prisma.patient.upsert({ where: { userId: user.id }, update: {}, create: { userId: user.id } });
    }
  }
  console.log("Seed complete");
}
main().finally(() => prisma.$disconnect());
````

