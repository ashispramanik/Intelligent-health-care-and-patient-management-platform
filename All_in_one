## `backend/src/middleware/authenticate.ts`

````ts
import { NextFunction, Request, Response } from "express";
import jwt from "jsonwebtoken";
import { env } from "../config/env";

export type AuthUser = { id: string; roles: string[] };
declare global { namespace Express { interface Request { user?: AuthUser } } }

export function authenticate(req: Request, res: Response, next: NextFunction) {
  const h = req.headers.authorization;
  if (!h?.startsWith("Bearer ")) return res.status(401).json({ error: "Unauthenticated" });
  try {
    const p = jwt.verify(h.slice(7), env.JWT_ACCESS_SECRET) as { sub: string; roles: string[] };
    req.user = { id: p.sub, roles: p.roles };
    next();
  } catch { res.status(401).json({ error: "Invalid or expired token" }); }
}
````

