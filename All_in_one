              <Route path="/nurse/dashboard" element={page(["NURSE"], <RolePage title="Nurse station" items={["Record vital signs", "Patient triage queue", "Assist consultations"]} />)} />
              <Route path="/admin/dashboard" element={page(["ADMIN"], <RolePage title="Hospital analytics" items={["Appointments & capacity", "Billing overview", "Audit logs & security alerts"]} />)} />
              <Route path="/admin/users" element={page(["ADMIN"], <UsersPage />)} />
